# SigsHub Autos — Production Environment Variables
# Copy these values into Hostinger hPanel > Node.js > Environment Variables
# or create a .env.local file in the deployment root.

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Security
ADMIN_PASSWORD=your-secure-admin-password

# Server
NODE_ENV=production
PORT=3000